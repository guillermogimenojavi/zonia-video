 "structures": [
  {
   "id": "no-solo",
   "regex": "(?i)\\bno (?:es )?(?:solo|sólo|solamente) [^.!?\\n]{2,60}[,.;]\\s*(?:es|sino)\\b",
   "name": "«No es solo X, es Y»",
   "fix": "Di lo único que quieres decir. Borra la mitad de la preparación."
  },
  {
   "id": "no-solo-sino",
   "regex": "(?i)\\bno (?:solo|sólo) [^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
   "name": "«No solo X, sino también Y»",
   "fix": "Dos frases, o quita la mitad débil."
  },
  {
   "id": "no-x-sino-y",
   "regex": "(?i)\\bno (?:es|se trata de) [^.!?\\n]{2,60}\\bsino\\b",
   "name": "Contraste «no X, sino Y»",
   "fix": "La marca permite uno por pieza: si hay más, quita los demás."
  },
  {
   "id": "el-resultado",
   "regex": "(?m)^\\s*(?:¿)?(?:el resultado|la respuesta|la clave|el truco|el secreto)\\s*[?:]",
   "name": "Pregunta retórica de una palabra («¿El resultado?»)",
   "fix": "Dilo directamente en la frase anterior."
  },
  {
   "id": "aqui-va",
   "regex": "(?i)\\b(?:aquí (?:te )?(?:va|van|tienes)|esto es lo que (?:necesitas|tienes que) saber)\\b",
   "name": "«Aquí va / esto es lo que necesitas saber»",
   "fix": "Empieza por lo que vas a decir."
  },
  {
   "id": "triada",
   "regex": "(?i)\\b(\\w+), (\\w+) y (\\w+)[.!]",
   "name": "Tríada automática (X, Y y Z)",
   "fix": "Si no son tres cosas de verdad, quédate con una o dos."
  },
  {
   "id": "leccion",
   "regex": "(?i)\\b(?:deberías|debes|tienes que|recuerda|nunca olvides)\\b",
   "name": "Lección al espectador",
   "fix": "La marca no sermonea: cuéntalo como algo que pasa o que viste."
  },
  {
   "id": "en-resumen",
   "regex": "(?im)^\\s*(?:en resumen|en conclusión|para concluir|en definitiva)\\b",
   "name": "Cierre de redacción («En resumen»)",
   "fix": "Cierra con la conclusión, sin anunciarla."
  },
  {
   "id": "cebo",
   "regex": "(?i)\\b(?:sígueme para|guarda este|comparte (?:este|con)|etiqueta a|dale (?:like|me gusta)|comenta (?:si|abajo))\\b",
   "name": "Petición cebo",
   "fix": "Sin llamadas a la acción salvo que quien publica la pida, y una como mucho."
  },
  {
   "id": "scroll",
   "regex": "(?i)\\b(?:deja de|para el) (?:hacer )?scroll\\b",
   "name": "«Deja de hacer scroll»",
   "fix": "Pedir atención demuestra que no la has ganado."
  },
  {
   "id": "preambulo",
   "regex": "(?i)\\ben (?:este|el) (?:vídeo|video|reel)(?: de hoy)?\\b|\\bte voy a (?:enseñar|contar|explicar)\\b",
   "name": "Preámbulo de vídeo",
   "fix": "Bórralo y empieza por lo importante."
  },
  {
   "id": "emoji",
   "regex": "[🌀-🫿☀-➿]",
   "name": "Emoji",
   "fix": "La marca no usa emojis."
  },
  {
   "id": "hashtags",
   "regex": "(?:#\\w+\\s*){6,}",
   "name": "Muro de hashtags",
   "fix": "Como mucho cinco, y solo si quien publica los quiere."
  },
  {
   "id": "gritos",
   "regex": "\\b[A-ZÁÉÍÓÚÑ]{3,}\\s+[A-ZÁÉÍÓÚÑ]{3,}\\s+[A-ZÁÉÍÓÚÑ]{3,}\\b",
   "name": "Tres palabras seguidas en mayúsculas",
   "fix": "En un pie o un guion, tipo oración."
  },
  {
   "id": "vinetas-emoji",
   "regex": "(?m)^\\s*[🌀-🫿☀-➿]\\s",
   "name": "Lista con emojis",
   "fix": "Frases seguidas, sin viñetas."
  },
  {
   "id": "como-ia",
   "regex": "(?i)\\bcomo (?:modelo de lenguaje|inteligencia artificial|ia)\\b",
   "name": "«Como IA…»",
   "fix": "Bórralo."
  }
 ]
}
